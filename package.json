{
  "name": "ai-summary-widget",
  "version": "1.0.3",
  "description": "A small embeddable widget that lets visitors summarize your brand, product, feature or article with ChatGPT, Claude, Perplexity, Gemini, and more.",
  "main": "dist/widget.min.js",
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "terser src/widget.js -c passes=2 -m -o dist/widget.min.js",
    "size": "wc -c dist/widget.min.js && gzip -c dist/widget.min.js | wc -c"
  },
  "keywords": [
    "ai",
    "summary",
    "widget",
    "chatgpt",
    "claude",
    "perplexity",
    "gemini",
    "embed",
    "script",
    "summarize"
  ],
  "author": "Trilok Yadav (https://trilokyadav.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trilokyadav/ai-summary-widget.git"
  },
  "homepage": "https://trilokyadav.com/projects/ai-summary-widget",
  "bugs": {
    "url": "https://github.com/trilokyadav/ai-summary-widget/issues"
  },
  "devDependencies": {
    "terser": "^5"
  }
}
